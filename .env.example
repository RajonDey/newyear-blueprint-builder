# ── Database ──
# Production / staging: Neon (see docs/DEPLOYMENT.md)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Local dev (fast): docker compose up -d  →  then use:
# DATABASE_URL="postgresql://yearinreview:yearinreview@localhost:5432/yearinreview"
#
# Comma-separated emails to promote to ADMIN (user must exist—sign in once first). Then: npm run db:seed
# After seed: sign out and sign back in so JWT picks up role.
SEED_ADMIN_EMAILS=""
# Full-app QA dummy data for manual testing (sign in once first):
# SEED_QA_EMAIL="you@example.com"
# SEED_QA_RESET=true   # optional — wipe QA plan + re-seed

# ── Auth (NextAuth.js v5) ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # Generate: openssl rand -base64 32

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Resend) ──
RESEND_API_KEY=""
EMAIL_FROM="YearInReview <noreply@yearinreview.online>"

# ── Payments (Lemon Squeezy) ──
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_PRO_MONTHLY_VARIANT_ID=""
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=""

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="YearInReview"
# Hostname for Terms/Privacy footer (never localhost in copy). Defaults to yearinreview.online when APP_URL is local.
NEXT_PUBLIC_LEGAL_SITE_DOMAIN="yearinreview.online"
# Shown on legal pages and support (mailto). Use your real support inbox in production.
NEXT_PUBLIC_SUPPORT_EMAIL="support@yearinreview.online"

# ── Rate limiting (recommended for production) ──
# Upstash Redis — free tier at https://upstash.com — limits /api/auth/* per IP
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Cron Jobs (Vercel Cron) ──
CRON_SECRET="" # Generate: openssl rand -base64 32

# ── Analytics (Optional) ──
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
