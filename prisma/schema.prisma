generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  planTier      PlanTier  @default(FREE)
  timezone      String    @default("UTC")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  yearlyPlans  YearlyPlan[]
  streaks      Streak[]
  achievements Achievement[]
  subscription Subscription?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── SUBSCRIPTIONS ───────────────────────────────────

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  lsCustomerId       String             @unique
  lsSubscriptionId   String?            @unique
  lsVariantId        String?
  status             SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── YEARLY PLANS ────────────────────────────────────

model YearlyPlan {
  id          String     @id @default(cuid())
  userId      String
  year        Int
  status      PlanStatus @default(DRAFT)
  reflections Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wheelEntries     WheelOfLifeEntry[]
  goals            Goal[]
  antiGoals        AntiGoal[]
  weeklyCheckIns   WeeklyCheckIn[]
  weeklyPlans      WeeklyPlan[]
  quarterlyReviews QuarterlyReview[]

  @@unique([userId, year])
  @@map("yearly_plans")
}

// Forward-looking weekly intent (Plan beat); pairs with WeeklyCheckIn (Review beat).
model WeeklyPlan {
  id              String         @id @default(cuid())
  planId          String
  weekNumber      Int
  year            Int
  priorityGoalIds String[]       @default([])
  protectCategory LifeCategory?
  commitments     Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  plan YearlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, weekNumber, year])
  @@map("weekly_plans")
}

// ─── WHEEL OF LIFE ───────────────────────────────────

model WheelOfLifeEntry {
  id         String       @id @default(cuid())
  planId     String
  category   LifeCategory
  rating     Int
  recordedAt DateTime     @default(now())
  context    String?

  plan YearlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, recordedAt])
  @@map("wheel_of_life_entries")
}

// ─── GOALS ───────────────────────────────────────────

model Goal {
  id          String       @id @default(cuid())
  planId      String
  category    LifeCategory
  type        GoalType
  title       String
  description String?      @db.Text
  status      GoalStatus   @default(NOT_STARTED)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  plan            YearlyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  actions         Action[]
  checkpointGoals CheckpointGoal[]
  dailySystems    DailySystem[]
  habits          Habit[]
  motivation      Motivation?
  goalCheckIns    GoalCheckIn[]

  @@map("goals")
}

model CheckpointGoal {
  id          String     @id @default(cuid())
  goalId      String
  quarter     Quarter
  title       String
  description String?    @db.Text
  status      GoalStatus @default(NOT_STARTED)
  targetDate  DateTime?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("checkpoint_goals")
}

model Action {
  id          String     @id @default(cuid())
  goalId      String
  type        ActionType
  description String     @db.Text
  status      GoalStatus @default(NOT_STARTED)
  targetDate  DateTime?

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("actions")
}

model DailySystem {
  id          String    @id @default(cuid())
  goalId      String
  description String
  frequency   Frequency @default(DAILY)
  isActive    Boolean   @default(true)

  goal        Goal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  completions SystemCompletion[]

  @@map("daily_systems")
}

model SystemCompletion {
  id          String   @id @default(cuid())
  systemId    String
  completedAt DateTime @default(now())
  date        DateTime @db.Date

  system DailySystem @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@unique([systemId, date])
  @@map("system_completions")
}

model Habit {
  id             String    @id @default(cuid())
  goalId         String
  description    String    @db.Text
  routineFormula String?
  frequency      Frequency @default(MONTHLY)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("habits")
}

model Motivation {
  id              String @id @default(cuid())
  goalId          String @unique
  whyText         String @db.Text
  consequenceText String @db.Text

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@map("motivations")
}

model AntiGoal {
  id          String        @id @default(cuid())
  planId      String
  description String        @db.Text
  category    LifeCategory?

  plan YearlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("anti_goals")
}

// ─── CHECK-INS ───────────────────────────────────────

model WeeklyCheckIn {
  id             String   @id @default(cuid())
  planId         String
  weekNumber     Int
  year           Int
  overallMood    Int?
  notes          String?  @db.Text
  nextWeekFocus  String?  @db.Text
  completedAt    DateTime @default(now())

  plan         YearlyPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  goalCheckIns GoalCheckIn[]

  @@unique([planId, weekNumber, year])
  @@map("weekly_check_ins")
}

model GoalCheckIn {
  id              String  @id @default(cuid())
  weeklyCheckInId String
  goalId          String
  progressRating  Int
  notes           String? @db.Text
  blockers        String? @db.Text

  weeklyCheckIn WeeklyCheckIn @relation(fields: [weeklyCheckInId], references: [id], onDelete: Cascade)
  goal          Goal          @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([weeklyCheckInId, goalId])
  @@map("goal_check_ins")
}

// ─── QUARTERLY REVIEWS ───────────────────────────────

model QuarterlyReview {
  id                  String   @id @default(cuid())
  planId              String
  quarter             Quarter
  summary             String?  @db.Text
  winsText            String?  @db.Text
  challengesText      String?  @db.Text
  adjustments         String?  @db.Text
  wheelOfLifeSnapshot Json?
  completedAt         DateTime @default(now())

  plan YearlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, quarter])
  @@map("quarterly_reviews")
}

// ─── GAMIFICATION ────────────────────────────────────

model Streak {
  id              String     @id @default(cuid())
  userId          String
  type            StreakType
  currentStreak   Int        @default(0)
  longestStreak   Int        @default(0)
  lastCompletedAt DateTime?
  shieldsUsed     Int        @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("streaks")
}

model Achievement {
  id       String   @id @default(cuid())
  userId   String
  type     String
  title    String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("achievements")
}

// ─── ENUMS ───────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum LifeCategory {
  HEALTH
  CAREER
  FINANCE
  RELATIONSHIPS
  SPIRITUALITY
  PASSION
}

enum GoalType {
  PRIMARY
  SECONDARY
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_TRACK
  AT_RISK
  COMPLETED
  ABANDONED
}

enum ActionType {
  SMALL
  MEDIUM
  BIG
}

enum Quarter {
  Q1
  Q2
  Q3
  Q4
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum StreakType {
  WEEKLY_CHECK_IN
  DAILY_SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}
