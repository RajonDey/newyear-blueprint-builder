// ─────────────────────────────────────────────────────────────
// Foundation — the structural year-level entities.
// YearlyPlan, WheelOfLifeEntry, AntiGoal.
// (Vision / Area / VisionItem will live here once added in Step 2.4.)
// ─────────────────────────────────────────────────────────────

model YearlyPlan {
  id          String     @id @default(cuid())
  userId      String
  year        Int
  status      PlanStatus @default(DRAFT)
  reflections Json?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wheelEntries     WheelOfLifeEntry[]
  projects         Project[]
  antiGoals        AntiGoal[]
  weeklyCheckIns   WeeklyCheckIn[]
  weeklyPlans      WeeklyPlan[]
  monthlyPlans     MonthlyPlan[]
  monthlyReviews   MonthlyReview[]
  quarterlyPlans   QuarterlyPlan[]
  quarterlyReviews QuarterlyReview[]

  @@unique([userId, year])
  @@map("yearly_plans")
}

model WheelOfLifeEntry {
  id         String       @id @default(cuid())
  planId     String
  category   LifeCategory
  rating     Int
  recordedAt DateTime     @default(now())
  context    String?

  plan YearlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, recordedAt])
  @@map("wheel_of_life_entries")
}

model AntiGoal {
  id          String        @id @default(cuid())
  planId      String
  description String        @db.Text
  category    LifeCategory?

  plan        YearlyPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  dailyStates DailyState[]

  @@map("anti_goals")
}

// ─────────────────────────────────────────────────────────────
// PARA / Second Brain foundation (Phase 2 additions)
// ─────────────────────────────────────────────────────────────

/// PARA life domain — Health, Career, etc. Seeded with six defaults per user;
/// Pro users can add custom domains.
model Area {
  id          String        @id @default(cuid())
  userId      String
  name        String
  /// Hex color or token (e.g. "amber", "cyan"). Used for UI accents.
  color       String        @default("#d4a05c")
  /// Optional lucide icon name (e.g. "Heart", "Briefcase").
  icon        String?
  description String?       @db.Text
  /// Soft-mapping to legacy LifeCategory so existing Projects can attach
  /// to their canonical default Area on back-fill.
  category    LifeCategory?
  isDefault   Boolean       @default(false)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]
  visionItems VisionItem[]

  @@index([userId, sortOrder])
  @@map("areas")
}

/// Life-spanning vision board. One per user — not tied to a YearlyPlan.
/// Holds a north-star prose statement; the board itself lives in `VisionItem[]`.
model Vision {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// The north-star prose statement ("Who am I becoming?").
  northStar String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items VisionItem[]

  @@map("visions")
}

/// Individual card on the life vision board — statement, value, milestone,
/// image, or quote. Optionally anchors to an Area.
model VisionItem {
  id         String         @id @default(cuid())
  visionId   String
  areaId     String?
  kind       VisionItemKind
  title      String
  body       String?        @db.Text
  /// External URL for IMAGE kind (no upload for v1 — Pro file uploads are
  /// only allowed for Resource).
  imageUrl   String?
  order      Int            @default(0)
  /// Set when the user marks a MILESTONE as achieved.
  achievedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  vision Vision @relation(fields: [visionId], references: [id], onDelete: Cascade)
  area   Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Projects on the active yearly plan that explicitly serve this card.
  linkedProjects Project[]

  @@index([visionId, order])
  @@map("vision_items")
}
