// ─────────────────────────────────────────────────────────────
// Identity — user, NextAuth accounts/sessions, subscription.
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  planTier      PlanTier  @default(FREE)
  timezone      String    @default("UTC")
  /// App-level prefs (checklist dismiss, vision visit, etc.). See `lib/user-preferences.ts`.
  preferences   Json?
  /// When set, the account cannot sign in or call APIs (soft suspend). Use with JWT `accountActive`.
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  yearlyPlans  YearlyPlan[]
  streaks      Streak[]
  achievements Achievement[]
  subscription Subscription?

  // ── PARA / Second Brain relations (Phase 2)
  areas           Area[]
  vision          Vision?
  notes           Note[]
  resources       Resource[]
  drifts          Drift[]
  dailyStates     DailyState[]
  reviewTemplates ReviewTemplate[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  lsCustomerId       String             @unique
  lsSubscriptionId   String?            @unique
  lsVariantId        String?
  status             SubscriptionStatus @default(INACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
